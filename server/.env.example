# Server Port
PORT=3001

# Environment: development | production
NODE_ENV=development

# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/questionhub?schema=public"

# JWT Authentication
# IMPORTANT: Use a strong random string in production (e.g., openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Frontend URL (used for CORS and redirects)
FRONTEND_URL="http://localhost:5173"

# File Upload
UPLOAD_DIR="uploads"
MAX_FILE_SIZE=10485760  # 10MB in bytes

# CORS Origin (must match FRONTEND_URL)
CORS_ORIGIN="http://localhost:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100   # Max requests per window per IP
